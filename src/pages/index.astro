---
import Strona from '../layouts/Strona.astro';
import ListaWydarzen from '../components/ListaWydarzen.astro';
import SchemaWydarzen from '../components/SchemaWydarzen.astro';
import Subskrypcja from '../components/Subskrypcja.astro';
import Wojewodztwa from '../components/Wojewodztwa.astro';
import { turnieje } from '../lib/turnieje';
import { dzisiaj } from '../lib/daty';

const dzis = dzisiaj();
const nadchodzace = turnieje.filter((t) => t.koniec >= dzis);
const saTestowe = nadchodzace.some((t) => t.test);
---

<Strona>
  <SchemaWydarzen slot="head" turnieje={nadchodzace} />
  <link slot="head" rel="alternate" type="text/calendar" title="Kalendarz iFight" href="/kalendarz.ics" />
  <h1 class="ukryty">Nadchodzące wydarzenia bokserskie w Polsce</h1>

  {
    saTestowe && (
      <p class="uwaga">
        Serwis w budowie: wpisy oznaczone [TEST] to dane testowe, a nie prawdziwe wydarzenia.
      </p>
    )
  }

  <ListaWydarzen turnieje={nadchodzace} dzis={dzis} />
  <Subskrypcja sciezka="/kalendarz.ics" />
  <Wojewodztwa nadchodzace={nadchodzace} />
</Strona>
