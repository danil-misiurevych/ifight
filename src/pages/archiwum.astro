---
import Strona from '../layouts/Strona.astro';
import Wiersz from '../components/Wiersz.astro';
import { turnieje } from '../lib/turnieje';
import { dzisiaj, nazwaMiesiaca } from '../lib/daty';

// Events that ended before the build, newest first.
const dzis = dzisiaj();
const minione = turnieje.filter((t) => t.koniec < dzis).reverse();
const miesiace = [...new Set(minione.map((t) => t.start.slice(0, 7)))];
---

<Strona
  tytul="Archiwum wydarzeń"
  opis="Archiwum wydarzeń bokserskich w Polsce, które już się odbyły: turnieje, gale, wydarzenia charytatywne i sparingi."
>
  <h1 class="tytul-strony">Archiwum wydarzeń</h1>
  <p class="szary">Wydarzenia, które już się odbyły. Nadchodzące są na <a href="/">stronie głównej</a>.</p>
  {
    miesiace.map((m) => (
      <section class="miesiac">
        <h2>{nazwaMiesiaca(m)}</h2>
        <ul class="lista">
          {minione.filter((t) => t.start.startsWith(m)).map((t) => <Wiersz t={t} dzis={dzis} archiwum />)}
        </ul>
      </section>
    ))
  }
  {minione.length === 0 && <p class="pusto">Archiwum jest jeszcze puste.</p>}
</Strona>
