---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-ext-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-ext-600.css';
import '@fontsource/barlow-condensed/latin-700-italic.css';
import '@fontsource/barlow-condensed/latin-ext-700-italic.css';
import '@fontsource/barlow-condensed/latin-800-italic.css';
import '@fontsource/barlow-condensed/latin-ext-800-italic.css';
import '@fontsource/space-mono/latin-700.css';
import '@fontsource/space-mono/latin-ext-700.css';
import '../styles/global.css';
import { SITE } from '../site';
import Analytics from '@vercel/analytics/astro';

interface Props {
  tytul?: string;
  opis?: string;
  /** Page type for Open Graph. */
  ogTyp?: 'website' | 'article';
  // Keeps the page out of search results (e.g. a region page with no events yet).
  noindex?: boolean;
  /** Share image path (1200×630), e.g. '/og/wydarzenia/<slug>.png'. */
  obraz?: string;
  /** Alt text for the share image. */
  obrazOpis?: string;
}
const {
  tytul,
  opis = SITE.opis,
  ogTyp = 'website',
  noindex = false,
  obraz = '/og/strona.png',
  obrazOpis = `${SITE.nazwa} – ${SITE.haslo}`,
} = Astro.props;
const obrazUrl = new URL(obraz, Astro.site);
const pelnyTytul = tytul ? `${tytul} – ${SITE.nazwa}` : `${SITE.haslo} – ${SITE.nazwa}`;
const kanoniczny = new URL(Astro.url.pathname, Astro.site);
// The "Wydarzenia" link is shown only on the "O stronie" page; everywhere else the logo leads to the list.
const naOStronie = Astro.url.pathname.startsWith('/o-stronie');
const rok = new Date().getFullYear();
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pelnyTytul}</title>
    <meta name="description" content={opis} />
    <meta name="theme-color" content="#120428" />
    <link rel="canonical" href={kanoniczny} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogTyp} />
    <meta property="og:site_name" content={SITE.nazwa} />
    <meta property="og:title" content={pelnyTytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={obrazUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={obrazOpis} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <!-- Statystyki odwiedzin: Vercel Web Analytics (bez ciasteczek). -->
    <Analytics />
  </head>
  <body>
    <header class="naglowek">
      <div class="strona naglowek-wnetrze">
        <a class="logo" href="/" aria-label={`${SITE.nazwa} – strona główna`}>
          <span class="logo-znak">{SITE.nazwa}</span>
          <span class="logo-dopisek">wydarzenia bokserskie w Polsce</span>
        </a>
        <nav class="menu" aria-label="Menu">
          {naOStronie ? <a href="/">Wydarzenia</a> : <a href="/o-stronie/">O stronie</a>}
        </nav>
      </div>
      <div class="paski" aria-hidden="true"></div>
    </header>
    <main class="strona">
      <slot />
    </main>
    <footer class="stopka">
      <div class="paski" aria-hidden="true"></div>
      <div class="strona">
        <nav class="stopka-menu" aria-label="Stopka">
          <a href="/">Wydarzenia</a>
          <a href="/archiwum/">Archiwum wydarzeń</a>
          <a href="/o-stronie/">O stronie</a>
          <a href="/o-stronie/#kontakt">Zgłoś wydarzenie</a>
        </nav>
        <p>
          {SITE.nazwa} to niezależny, nieoficjalny serwis – nie jest powiązany z żadnym związkiem
          ani organizatorem. Przed wyjazdem zawsze sprawdź aktualność informacji u organizatora.
        </p>
        <p class="prawa">© {rok} {SITE.nazwa}. Wszystkie prawa zastrzeżone.</p>
      </div>
    </footer>
  </body>
</html>
