---
// schema.org markup for events. Test entries are left out
// so that made-up events never reach search engines as structured data.
import type { Turniej } from '../lib/turnieje';

interface Props {
  turnieje: Turniej[];
}
const wydarzenia = Astro.props.turnieje
  .filter((t) => !t.test)
  .map((t) => ({
    '@context': 'https://schema.org',
    '@type': t.typ === 'szkolenie' ? 'EducationEvent' : 'SportsEvent',
    name: t.nazwa,
    sport: 'Boxing',
    startDate: t.start,
    endDate: t.koniec,
    ...(t.opis && { description: t.opis }),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: t.miejsce ?? t.miasto,
      address: {
        '@type': 'PostalAddress',
        addressLocality: t.miasto,
        addressRegion: t.wojewodztwo,
        addressCountry: 'PL',
      },
    },
    ...(t.organizator && { organizer: { '@type': 'Organization', name: t.organizator } }),
    url: new URL(`/wydarzenia/${t.slug}/`, Astro.site).href,
    sameAs: t.zrodlo,
  }));
const json = JSON.stringify(wydarzenia.length === 1 ? wydarzenia[0] : wydarzenia).replace(/</g, '\\u003c');
---

{wydarzenia.length > 0 && <script type="application/ld+json" set:html={json} />}
