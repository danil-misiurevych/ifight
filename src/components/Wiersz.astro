---
import { Image } from 'astro:assets';
import type { Turniej } from '../lib/turnieje';
import { slug, TYP_ETYKIETA, UDZIAL_ETYKIETA } from '../lib/turnieje';
import { krotkaData, stanTerminu, zakresDat } from '../lib/daty';
import { SITE } from '../site';

interface Props {
  t: Turniej;
  dzis: string;
  /** In the archive the year is shown and the entry deadline is left out. */
  archiwum?: boolean;
}
const { t, dzis, archiwum = false } = Astro.props;

const plec =
  t.plec.length === 2 ? 'K+M' : t.plec[0] === 'K' ? 'kobiety' : t.plec[0] === 'M' ? 'mężczyźni' : '';

// Only non-empty parts are shown, so missing optional fields just shorten the row.
const meta = [
  `${t.miasto}, ${t.wojewodztwo}`,
  t.kategorie.join(', '),
  plec,
  t.poziom,
  t.organizator && `org. ${t.organizator}`,
].filter(Boolean);

// Quick links on the card. The primary action depends on who the event is for:
// tickets for spectators, sign-up for those who can take part.
const link = (r: string) => t.linki.find((l) => l.rodzaj === r)?.url;
const przyciski = archiwum
  ? []
  : [
      { rodzaj: 'zapisy', etykieta: 'Zapisy', url: link('zapisy') },
      { rodzaj: 'bilety', etykieta: 'Bilety', url: link('bilety') },
      { rodzaj: 'organizator', etykieta: 'Organizator', url: link('facebook') },
    ].filter((p): p is { rodzaj: string; etykieta: string; url: string } => Boolean(p.url));
if (t.udzial.includes('widownia') && !t.udzial.some((u) => u !== 'widownia')) {
  przyciski.sort((a, b) => Number(b.rodzaj === 'bilety') - Number(a.rodzaj === 'bilety'));
}

const termin = !archiwum && t.termin_zgloszen && stanTerminu(t.termin_zgloszen, dzis, SITE.dniWkrotce);
---

<li
  class="t"
  data-koniec={t.koniec}
  data-typ={t.typ}
  data-mies={t.start.slice(0, 7)}
  data-woj={slug(t.wojewodztwo)}
  data-kat={t.kategorie.map(slug).join(' ')}
  data-plec={t.plec.join(' ')}
  data-udzial={t.udzial.join(' ')}
>
  {
    t.obraz ? (
      <Image class="t-obraz" src={t.obraz} alt="" width={420} loading="lazy" decoding="async" />
    ) : (
      <span class="t-obraz t-zaslepka" data-typ={t.typ} aria-hidden="true" />
    )
  }
  <time class="t-data" datetime={t.start}>
    {zakresDat(t.start, t.koniec)}{archiwum && <span class="t-rok">{t.start.slice(0, 4)}</span>}
  </time>
  <div class="t-opis">
    <span class="t-typ" data-typ={t.typ}>{TYP_ETYKIETA[t.typ].jeden}</span>
    {t.udzial.map((u) => <span class="t-udzial" data-udzial={u} title={UDZIAL_ETYKIETA[u].opis}>{UDZIAL_ETYKIETA[u].krotka}</span>)}
    <a class="t-nazwa" href={`/wydarzenia/${t.slug}/`}>{t.nazwa}</a>
    <span class="t-meta">{meta.join(' · ')}</span>
    <span class="t-akcje">
      {
        przyciski.map((p) => (
          <a class="t-akcja" data-rodzaj={p.rodzaj} href={p.url} target="_blank" rel="noopener">
            {p.etykieta} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
      <a class="t-akcja t-akcja-wiecej" href={`/wydarzenia/${t.slug}/`} tabindex="-1" aria-hidden="true">
        Szczegóły →
      </a>
    </span>
  </div>
  {
    termin && (
      <span class="termin" data-termin={t.termin_zgloszen} data-stan={termin.stan}>
        zgłoszenia do <span class="termin-data">{krotkaData(t.termin_zgloszen!)}</span>{' '}
        <span class="termin-dopisek">{termin.dopisek && `(${termin.dopisek})`}</span>
      </span>
    )
  }
</li>
